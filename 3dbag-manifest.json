{
  "version": "2025.11.18",
  "tools": {
    "tyler": {
      "version": "0.3.14",
      "url": "docker.io/3dgi/tyler:0.3.14",
      "type": "docker",
      "display_name": "tyler",
      "repository": "https://github.com/3DGI/tyler",
      "description": "Generating Cesium 3DTiles"
    },
    "tyler-multiformat": {
      "version": "0.4.0-alpha10",
      "url": "docker.io/3dgi/tyler-multiformat:0.4.0-alpha10",
      "type": "docker",
      "display_name": "tyler-multiformat",
      "repository": "https://github.com/3DGI/tyler/tree/multi-format-output",
      "description": "Generating GeoPackage, OBJ and CityJSON tiles"
    },
    "tyler-db": {
      "version": "0.3.4-db-alpha5",
      "url": "docker.io/3dgi/tyler-db:0.3.4-db-alpha5",
      "type": "docker",
      "display_name": "tyler-db",
      "repository": "https://github.com/3DGI/tyler/tree/postgres-footprints",
      "description": "Input tiling"
    },
    "roofer": {
      "version": "develop",
      "url": "docker.io/3dgi/roofer:develop",
      "type": "docker",
      "display_name": "roofer",
      "repository": "https://github.com/3DBAG/roofer",
      "description": "Point cloud selection and building reconstruction"
    },
    "geoflow-bundle": {
      "version": "2025.09.01",
      "url": "docker.io/3dgi/geoflow-bundle-builder:2025.09.01",
      "type": "docker",
      "display_name": "geoflow-bundle",
      "repository": "https://github.com/geoflow3d/geoflow-bundle",
      "description": "Format conversion to CityJSON, OBJ, GeoPackage, glTF"
    },
    "cjval": {
      "version": "0.8.2",
      "url": "docker.io/tudelft3d/cjval:0.8.2",
      "type": "docker"
    },
    "uv": {
      "version": "0.8.2",
      "url": "ghcr.io/astral-sh/uv:0.8.2",
      "type": "docker"
    },
    "gdal": {
      "version": "3.8.5",
      "url": "https://github.com/OSGeo/gdal/releases/download/v3.8.5/gdal-3.8.5.tar.gz",
      "type": "source",
      "display_name": "GDAL",
      "repository": "https://gdal.org/",
      "description": "Data loading with ogr2ogr"
    },
    "proj": {
      "version": "9.4.0",
      "url": "https://download.osgeo.org/proj/proj-9.4.0.tar.gz",
      "type": "source"
    },
    "geos": {
      "version": "3.12.1",
      "url": "https://download.osgeo.org/geos/geos-3.12.1.tar.bz2",
      "type": "source"
    },
    "geotiff": {
      "version": "1.7.3",
      "url": "https://github.com/OSGeo/libgeotiff/releases/download/1.7.3/libgeotiff-1.7.3.tar.gz",
      "type": "source"
    },
    "lastools": {
      "version": "2.0.4",
      "url": "https://github.com/LAStools/LAStools/archive/refs/tags/v2.0.4.zip",
      "type": "source",
      "display_name": "LASTools",
      "repository": "https://lastools.github.io/",
      "description": "Point cloud tiling and indexing"
    },
    "pdal": {
      "version": "2.10.1",
      "url": "https://github.com/PDAL/PDAL/releases/download/2.10.1/PDAL-2.10.1-src.tar.gz",
      "type": "source",
      "display_name": "PDAL",
      "repository": "https://pdal.io",
      "description": "Computing point cloud metadata"
    },
    "val3dity": {
      "version": "2.4.0",
      "url": "https://github.com/tudelft3d/val3dity/archive/refs/tags/2.4.0.zip",
      "type": "source"
    },
    "cjio": {
      "version": "0.9.2",
      "url": "https://pypi.org/project/cjio/",
      "type": "pipx"
    }
  },
  "pipeline": [
    {
      "name": "source_input",
      "display_name": "source_input / ahn_tile_index",
      "allow_partial_failure": false,
      "jobs": [
        { "job": "source_input",   "code_location": "core" },
        { "job": "ahn_tile_index", "code_location": "core" }
      ]
    },
    {
      "name": "ahn",
      "display_name": "ahn downloads (ahn3/4/5)",
      "allow_partial_failure": true,
      "partition_asset": ["ahn", "laz_files_ahn3"],
      "jobs": [
        { "job": "ahn3", "code_location": "core" },
        { "job": "ahn4", "code_location": "core" },
        { "job": "ahn5", "code_location": "core" }
      ]
    },
    {
      "name": "ahn_metadata_index",
      "display_name": "ahn_metadata_index",
      "allow_partial_failure": false,
      "jobs": [
        { "job": "ahn_metadata_index", "code_location": "core" }
      ]
    },
    {
      "name": "reconstruct",
      "display_name": "reconstruct",
      "allow_partial_failure": true,
      "partition_asset": ["reconstruction", "reconstructed_building_models"],
      "jobs": [
        { "job": "reconstruct", "code_location": "core" }
      ]
    },
    {
      "name": "party_walls_index",
      "display_name": "party_walls_index",
      "allow_partial_failure": false,
      "jobs": [
        { "job": "party_walls_index", "code_location": "party_walls" }
      ]
    },
    {
      "name": "party_walls",
      "display_name": "party_walls",
      "allow_partial_failure": false,
      "jobs": [
        { "job": "party_walls", "code_location": "party_walls" }
      ]
    },
    {
      "name": "floors_estimation",
      "display_name": "floors_estimation",
      "allow_partial_failure": false,
      "jobs": [
        { "job": "floors_estimation", "code_location": "floors_estimation" }
      ]
    },
    {
      "name": "export",
      "display_name": "export",
      "allow_partial_failure": false,
      "jobs": [
        { "job": "export", "code_location": "export" }
      ]
    }
  ]
}
